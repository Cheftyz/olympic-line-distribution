# Copy to .env for local development (or set these in your host's dashboard).

# --- Admin login (protects /admin and product create/delete) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# --- Database ---
# When set, products are stored in MongoDB (Atlas). When left blank, the app
# falls back to a local JSON file at data/products.json (dev only).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/olympic?retryWrites=true&w=majority

# --- Server ---
PORT=3000
